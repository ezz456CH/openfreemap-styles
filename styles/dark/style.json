      "id": "label_other",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "minzoom": 8,
      "filter": [
        "match",
        ["get", "class"],
        ["city", "continent", "country", "state", "town", "village"],
